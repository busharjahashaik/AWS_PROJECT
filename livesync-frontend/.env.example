# ==================================================
# LiveSync - Frontend environment
# ==================================================

# false = talk to the real backend (Express + DynamoDB)  <- normal use
# true  = offline demo with fake data kept in the browser (no backend needed)
VITE_USE_MOCK_DATA=false

# URL of the LiveSync backend API (see the backend README)
VITE_API_URL=http://localhost:5001/api

# AWS AppSync real-time layer (optional).
# Leave these as they are to skip AppSync: the app then refreshes every 5 seconds instead.
VITE_APPSYNC_ENDPOINT=https://example-api-id.appsync-api.us-east-1.amazonaws.com/graphql
VITE_APPSYNC_API_KEY=da2-samplekey1234567890abcdef
VITE_AWS_REGION=us-east-1
