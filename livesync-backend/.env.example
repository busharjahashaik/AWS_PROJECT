# ---- Server ----
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Storage: "memory" (no AWS needed, data lost on restart) or "dynamodb" ----
STORE=memory

# ---- DynamoDB (only used when STORE=dynamodb) ----
AWS_REGION=us-east-1
USERS_TABLE=LiveSyncUsers
ORDERS_TABLE=LiveSyncOrders
LOGS_TABLE=LiveSyncActivity
RESTAURANTS_TABLE=LiveSyncRestaurants
MENU_ITEMS_TABLE=LiveSyncMenuItems

# ---- AWS AppSync (optional; leave blank to disable real-time publishing) ----
APPSYNC_ENDPOINT=
APPSYNC_API_KEY=

# ---- Behaviour ----
SEED_DEMO_USERS=true
AUTO_ASSIGN=true
ALLOW_ADMIN_REGISTER=true
